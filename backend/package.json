    "@types/node": "^22.10.7",
    "@types/nodemailer": "^7.0.3",
    "@types/passport-local": "^1.0.38",
    "@types/supertest": "^6.0.2",
    "@types/validator": "^13.15.3",
    "class-validator": "^0.14.2",
    "eslint": "^9.18.0",
    "eslint-config-prettier": "^10.0.1",
    "eslint-plugin-prettier": "^5.2.2",
    "globals": "^16.0.0",
    "jest": "^30.0.0",
    "prettier": "^3.4.2",
    "prisma": "^6.16.2",
    "source-map-support": "^0.5.21",
    "supertest": "^7.0.0",
    "ts-jest": "^29.2.5",
    "ts-loader": "^9.5.2",
    "ts-node": "^10.9.2",
